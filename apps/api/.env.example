PORT=3001
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sw_exchange
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
ADMIN_EMAIL=admin@swexchange.local
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe123!

# 32 random bytes encoded as 64 hex characters; required in production.
# Generate: openssl rand -hex 32. Keep separate from JWT_SECRET.
TOTP_ENCRYPTION_KEY=
