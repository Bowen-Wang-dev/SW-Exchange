# Change these before deploying.
POSTGRES_USER=sw_exchange
POSTGRES_PASSWORD=change-this-postgres-password
POSTGRES_DB=sw_exchange
PORT=3001
# Keep this aligned with the Postgres values above.
DATABASE_URL=postgresql://sw_exchange:change-this-postgres-password@postgres:5432/sw_exchange
JWT_SECRET=change-this-jwt-secret
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
WEB_APP_URL=http://localhost:3000
EMAIL_PROVIDER=console
EMAIL_FROM=no-reply@example.com
EMAIL_VERIFICATION_TOKEN_TTL_MINUTES=60
NEXT_PUBLIC_API_URL=http://localhost:3001/api
# Change these admin bootstrap values before deploying.
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-admin-password
